# Christmas Tree Model
# Pine tree with correct normals for lighting

# ===== TRUNK (box) =====
# Bottom face
v -0.15 0.0 -0.15
v  0.15 0.0 -0.15
v  0.15 0.0  0.15
v -0.15 0.0  0.15
# Top face
v -0.15 0.8 -0.15
v  0.15 0.8 -0.15
v  0.15 0.8  0.15
v -0.15 0.8  0.15

# ===== LOWER CONE (widest) =====
# Center bottom
v 0.0 0.7 0.0
# Base vertices (8 segments)
v  1.3  0.7  0.0
v  0.92 0.7  0.92
v  0.0  0.7  1.3
v -0.92 0.7  0.92
v -1.3  0.7  0.0
v -0.92 0.7 -0.92
v  0.0  0.7 -1.3
v  0.92 0.7 -0.92
# Tip
v 0.0 2.0 0.0

# ===== MIDDLE CONE =====
# Center bottom
v 0.0 1.5 0.0
# Base vertices
v  1.0  1.5  0.0
v  0.71 1.5  0.71
v  0.0  1.5  1.0
v -0.71 1.5  0.71
v -1.0  1.5  0.0
v -0.71 1.5 -0.71
v  0.0  1.5 -1.0
v  0.71 1.5 -0.71
# Tip
v 0.0 2.8 0.0

# ===== UPPER CONE (narrowest) =====
# Center bottom
v 0.0 2.3 0.0
# Base vertices
v  0.7  2.3  0.0
v  0.5  2.3  0.5
v  0.0  2.3  0.7
v -0.5  2.3  0.5
v -0.7  2.3  0.0
v -0.5  2.3 -0.5
v  0.0  2.3 -0.7
v  0.5  2.3 -0.5
# Tip
v 0.0 3.5 0.0

# ===== NORMALS =====
# Down normal (for bases)
vn  0.0 -1.0  0.0
# Up normal
vn  0.0  1.0  0.0
# Trunk side normals
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0

# Cone side normals (pointing outward and upward at ~30 degrees)
vn  0.866  0.5  0.0
vn  0.612  0.5  0.612
vn  0.0    0.5  0.866
vn -0.612  0.5  0.612
vn -0.866  0.5  0.0
vn -0.612  0.5 -0.612
vn  0.0    0.5 -0.866
vn  0.612  0.5 -0.612

# ===== TRUNK FACES =====
# Bottom
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# Top
f 5//2 7//2 6//2
f 5//2 8//2 7//2
# Front (-Z)
f 1//3 2//3 6//3
f 1//3 6//3 5//3
# Right (+X)
f 2//4 3//4 7//4
f 2//4 7//4 6//4
# Back (+Z)
f 3//5 4//5 8//5
f 3//5 8//5 7//5
# Left (-X)
f 4//6 1//6 5//6
f 4//6 5//6 8//6

